{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.diffusiongemma/grounding_evidence.schema.json",
  "title": "DiffusionGemma Grounding Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "analysis_status",
    "observed_facts",
    "inferred_facts",
    "creative_additions",
    "uncertainties",
    "grounding_failure_reasons"
  ],
  "properties": {
    "schema": {"const": "dg-grounding-ledger/1"},
    "analysis_status": {
      "enum": ["grounded", "uncertain", "refused", "transport_error"]
    },
    "observed_facts": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/observedFact"}
    },
    "inferred_facts": {"$ref": "#/$defs/textList"},
    "creative_additions": {"$ref": "#/$defs/textList"},
    "uncertainties": {"$ref": "#/$defs/textList"},
    "grounding_failure_reasons": {"$ref": "#/$defs/textList"}
  },
  "$defs": {
    "textList": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"}
    },
    "observedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "claim", "confidence", "categories", "evidence"],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "claim": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "appearance",
              "object",
              "count",
              "color",
              "text",
              "spatial",
              "environment",
              "lighting",
              "action",
              "motion",
              "camera",
              "composition",
              "temporal",
              "other"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/evidenceReference"}
        },
        "typed_claims": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/typedClaim"}
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id"],
      "allOf": [
        {
          "if": {"properties": {"asset_id": {"pattern": "^video:"}}, "required": ["asset_id"]},
          "then": {"required": ["sample_ordinal", "source_frame_index", "timecode_seconds"]}
        }
      ],
      "dependentRequired": {
        "source_frame_index": ["sample_ordinal"],
        "timecode_seconds": ["sample_ordinal"]
      },
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^(?:image|picture|video):[1-9][0-9]*$"
        },
        "sample_ordinal": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "source_frame_index": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "timecode_seconds": {"type": "number", "minimum": 0}
      }
    },
    "typedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "claim_type", "value"],
      "allOf": [
        {
          "if": {"properties": {"asset_id": {"pattern": "^video:"}}, "required": ["asset_id"]},
          "then": {"required": ["sample_ordinal"]}
        }
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^(?:image|picture|video):[1-9][0-9]*$"
        },
        "claim_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"
        },
        "value": {
          "oneOf": [
            {"type": "string"},
            {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
            {"type": "boolean"},
            {"type": "null"}
          ]
        },
        "sample_ordinal": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      }
    }
  }
}

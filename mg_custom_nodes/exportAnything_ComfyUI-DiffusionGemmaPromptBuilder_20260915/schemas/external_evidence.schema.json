{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.diffusiongemma/external_evidence.schema.json",
  "title": "DiffusionGemma External Grounding Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "claims"],
  "properties": {
    "schema": {"const": "dg-external-evidence/1"},
    "provider": {
      "enum": ["manual", "ocr", "detector", "pose", "tracking", "motion", "siglip"]
    },
    "claims": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/typedClaim"}
    }
  },
  "$defs": {
    "typedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "claim_type", "value"],
      "allOf": [
        {
          "if": {"properties": {"asset_id": {"pattern": "^video:"}}, "required": ["asset_id"]},
          "then": {"required": ["sample_ordinal"]}
        }
      ],
      "dependentRequired": {
        "source_frame_index": ["sample_ordinal"],
        "timecode_seconds": ["sample_ordinal"]
      },
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^(?:image|picture|video):[1-9][0-9]*$"
        },
        "claim_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"
        },
        "value": {
          "oneOf": [
            {"type": "string"},
            {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
            {"type": "boolean"},
            {"type": "null"}
          ]
        },
        "sample_ordinal": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "source_frame_index": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "timecode_seconds": {"type": "number", "minimum": 0},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  }
}

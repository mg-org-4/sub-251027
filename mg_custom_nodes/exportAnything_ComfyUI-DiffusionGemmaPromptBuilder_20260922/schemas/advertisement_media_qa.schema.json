{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exportanything.dev/schemas/advertisement_media_qa.schema.json",
  "title": "DiffusionGemma Advertisement Media QA",
  "type": "object",
  "required": ["schema", "version", "campaign_id", "advertisement_contract_sha256", "host_required_checks", "checks", "overall_status", "ready_for_delivery", "report_sha256"],
  "properties": {
    "schema": {"const": "diffusiongemma.advertisement_media_qa"},
    "version": {"const": 1},
    "campaign_id": {"$ref": "#/$defs/sha256"},
    "advertisement_contract_sha256": {"$ref": "#/$defs/sha256"},
    "host_required_checks": {
      "const": ["product_identity", "performer_identity", "copy_legibility", "audio_sync", "technical_integrity"]
    },
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["check", "status", "evidence"], "properties": {"status": {"enum": ["pass", "fail", "not_measured"]}}}},
    "overall_status": {"enum": ["pass", "fail", "not_measured"]},
    "ready_for_delivery": {"type": "boolean"},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

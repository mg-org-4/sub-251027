{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exportanything.dev/schemas/advertisement_adaptation_status.schema.json",
  "title": "DiffusionGemma Advertisement Adaptation Status",
  "type": "object",
  "required": ["schema", "version", "campaign_id", "advertisement_contract_sha256", "master_aspect_ratio", "adaptations", "all_requested_rendered", "pixel_inputs_received", "ready", "report_sha256"],
  "properties": {
    "schema": {"const": "diffusiongemma.advertisement_adaptation_status"},
    "version": {"const": 1},
    "campaign_id": {"$ref": "#/$defs/sha256"},
    "advertisement_contract_sha256": {"$ref": "#/$defs/sha256"},
    "master_aspect_ratio": {"type": "string"},
    "adaptations": {"type": "array", "items": {"type": "object", "required": ["request", "aspect_ratio", "status", "reason"], "properties": {"status": {"enum": ["planned_not_rendered", "not_applicable_same_as_master", "impossible_invalid_aspect"]}}}},
    "all_requested_rendered": {"const": false},
    "pixel_inputs_received": {"const": false},
    "ready": {"const": true},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

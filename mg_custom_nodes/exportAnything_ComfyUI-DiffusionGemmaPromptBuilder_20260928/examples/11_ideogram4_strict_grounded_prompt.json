      "widgets_values": [
        "# Strict Ideogram prompt routing\n\nReplace `example.png` before queueing. Strict mode first verifies the image evidence, then compiles the Ideogram prompt from the validated ledger. The JSON Splitter routes `ideogram_prompt`, `ready_for_generation`, and metadata into the Generation Gate. This example intentionally ends at a harmless preview sink; connect the gate output to your local Ideogram-compatible consumer only after validating that consumer separately.\n\nNo cloud call is included in this workflow. A strict grounding failure leaves no downstream prompt."
      ],
      "color": "#222",
      "bgcolor": "#000",
      "title": "Acceptance workflow notes"
    }
